# =============================================================================
# Fruits Crew — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Auth providers (optional for MVP)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Payments (Phase later)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI (Phase 6)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Email
# RESEND_API_KEY=
# EMAIL_FROM=hello@fruitscrew.com

# Analytics (privacy-respecting)
# NEXT_PUBLIC_ANALYTICS_ID=
