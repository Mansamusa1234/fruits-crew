{
  "name": "fruits-crew",
  "version": "0.1.0",
  "private": true,
  "description": "Fruits Crew — Back to Nature. Children's educational entertainment universe.",
  "author": "Darren-neil",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @fruits-crew/database generate",
    "db:migrate": "pnpm --filter @fruits-crew/database migrate",
    "db:seed": "pnpm --filter @fruits-crew/database seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
